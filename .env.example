# Токен бота от @BotFather
BOT_TOKEN=

# Твой Telegram ID (узнать: /id в боте или @userinfobot). Бот отвечает только ему
OWNER_ID=

# Лимиты
MAX_ROUNDS=5
MAX_RETRIES=2
WORKER_TIMEOUT=900
BOSS_TIMEOUT=600

# Сдавать без подтверждения в Telegram (не включать, пока всё не проверено)
AUTO_SUBMIT=false

# Разрешить воркеру поиск в интернете
WORKER_WEB=false

# Исполнитель от отдельного пользователя: sudo (сервер, через /usr/local/bin/bitowi-worker-run) или local (разработка)
WORKER_MODE=sudo
WORKER_USER=bitowi-worker
WORKER_RUNNER=/usr/local/bin/bitowi-worker-run

# Песочница bubblewrap для воркера (AppArmor не ослабляем — false)
WORKER_SANDBOX=false

# Браузер
BROWSER_TIMEOUT=45
# больше вопросов на странице — делим на части
MAX_QUESTIONS=15
PLAYWRIGHT_MCP_BIN=playwright-mcp

# Режим курса: курьер (Codex + Playwright MCP по CDP к браузеру бота)
COURIER_TIMEOUT=300
COURSE_MAX_SHOTS=4
COURSE_VIEWPORT=1280x900
# доп. источники для --allowed-origins через «;» (CDN платформы); пусто — только домен курса
COURSE_EXTRA_ORIGINS=
# слова через «;», которые воркер не должен видеть (название вуза или платформы сверх встроенного списка)
COURSE_BANNED_WORDS=
# лимиты одного запуска курса: шаги, секунды, шаги на одной странице, тот же экран N раз подряд
COURSE_MAX_STEPS=300
COURSE_MAX_RUNTIME=7200
COURSE_MAX_STEPS_PER_PAGE=15
COURSE_STUCK_REPEATS=3
# шагов подряд, где не выполнено ни одно действие (элемент не найден и т. п.), до паузы
COURSE_FAIL_REPEATS=3
# Курьер от отдельного пользователя: sudo (сервер, через /usr/local/bin/bitowi-courier-run) или local (разработка)
COURIER_MODE=sudo
COURIER_USER=bitowi-courier
COURIER_RUNNER=/usr/local/bin/bitowi-courier-run
COURIER_ROOT=/srv/bitowi-courier
COURIER_MCP_BIN=/home/bitowi-courier/.local/bin/playwright-mcp

# Вход по форме (бот вводит сам, в промпты не попадает)
DEMO_MOODLE_USER=
DEMO_MOODLE_PASSWORD=
# мини-LMS (python -m e2e.fake_lms): пароль без значения по умолчанию, токен для /_stats
FAKE_LMS_USER=student
FAKE_LMS_PASSWORD=
FAKE_LMS_TOKEN=

# Пути. TASKS_DIR — вне домашней папки: общая папка бота и исполнителя (группа bitowi-tasks)
DATA_DIR=./data
TASKS_DIR=/srv/bitowi/tasks

# Папка с системными промптами босса и воркера (вне репозитория)
PROMPTS_DIR=/home/<user>/bitowi_instructions/prompts

# Пути к CLI (если не в PATH)
CLAUDE_BIN=claude
CODEX_BIN=codex
